{
  "name": "creator-ai-telegram-bot",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate:local": "wrangler d1 migrations apply creator-ai-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply creator-ai-db --remote"
  },
  "dependencies": {
    "hono": "^4.13.0",
    "drizzle-orm": "^0.44.7"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20261001.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4",
    "wrangler": "^4.40.0"
  }
}
